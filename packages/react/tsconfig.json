{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",

        "rootDir": "./src",
        "outDir": "./dist",

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}